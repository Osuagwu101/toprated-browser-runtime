{
  "name": "toprated/browser-runtime-api",
  "description": "Laravel control plane for the generic self-hosted browser runtime",
  "type": "project",
  "require": {
    "php": "^8.2",
    "laravel/framework": "12.26.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
