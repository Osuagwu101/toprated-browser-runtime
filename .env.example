# No production secret values belong in this file.
API_PORT=18080
WORKER_PORT=18081
APP_ENV=local
APP_DEBUG=false
WORKER_LOG_LEVEL=info
CHROMIUM_PATH=/usr/bin/chromium
VIEWER_TOKEN_TTL_SECONDS=600
VIEWER_FRAME_INTERVAL_MS=250
# Optional in local development; production must supply a long random value.
VIEWER_SIGNING_SECRET=
