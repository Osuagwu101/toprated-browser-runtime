APP_ENV=local
APP_DEBUG=false
APP_KEY=base64:replace-with-a-valid-laravel-application-key
APP_URL=http://localhost:18080
API_PORT=18080
WORKER_PORT=18081
BROWSER_WORKER_URL=http://browser-worker:8081
WORKER_CONTROL_SECRET=replace-with-a-random-worker-control-secret-at-least-32-bytes-long
DB_CONNECTION=sqlite
DB_DATABASE=/srv/runtime-api/storage/data/database.sqlite
RUNTIME_SERVICE_AUTH_SECRET=replace-with-a-random-service-secret-at-least-32-bytes-long
SERVICE_AUTH_MAX_SKEW_SECONDS=300
CHROMIUM_EXECUTABLE=/usr/bin/chromium
VIEWER_SIGNING_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
VIEWER_TOKEN_TTL_SECONDS=300
VIEWER_PUBLIC_BASE_URL=http://127.0.0.1:18081
MAX_BROWSER_SESSIONS=3
SESSION_LEASE_SECONDS=5400
SESSION_IDLE_TIMEOUT_SECONDS=900
SESSION_DISCONNECT_GRACE_SECONDS=180
SESSION_STARTUP_GRACE_SECONDS=30
SESSION_REAPER_INTERVAL_SECONDS=30
LOG_LEVEL=info
